9:T1297,{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"https://www.kryvazent.com/#webpage","url":"https://www.kryvazent.com","name":"Kryvazent | Custom Software, AI and Cloud Engineering in Sri Lanka","isPartOf":{"@id":"https://www.kryvazent.com/#website"},"about":{"@id":"https://www.kryvazent.com/#organization"},"primaryImageOfPage":{"@type":"ImageObject","url":"https://www.kryvazent.com/og-image.png","width":1200,"height":630},"description":"Kryvazent is a Colombo-based software development company building custom web apps, mobile apps, AI-enabled products, cloud infrastructure, backend systems, APIs, and UI/UX experiences for startups and growing businesses.","mainEntity":{"@id":"https://www.kryvazent.com/#services"},"inLanguage":"en"},{"@type":"BreadcrumbList","@id":"https://www.kryvazent.com/#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.kryvazent.com"}]},{"@type":"ItemList","@id":"https://www.kryvazent.com/#services","name":"Kryvazent software engineering services","itemListElement":[{"@type":"ListItem","position":1,"url":"https://www.kryvazent.com/services/custom-web-application-development/","name":"Custom Web Application Development","description":"Kryvazent designs and builds dashboards, portals, SaaS products, booking systems, ecommerce flows, internal tools, and customer-facing platforms with reliable frontend and backend architecture."},{"@type":"ListItem","position":2,"url":"https://www.kryvazent.com/services/mobile-application-development/","name":"Mobile Application Development","description":"Kryvazent builds mobile applications that help businesses deliver polished customer experiences, internal field tools, booking flows, commerce features, and product extensions on iOS and Android."},{"@type":"ListItem","position":3,"url":"https://www.kryvazent.com/services/ai-machine-learning-product-integration/","name":"AI and Machine Learning Product Integration","description":"Kryvazen